<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.sebitas13</groupId>
    <artifactId>java-file-handling-lab</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Java File Handling Lab</name>
    <description>Console exercises for text files, CSV and Java object serialization.</description>
    <url>https://github.com/Sebitas13/java-file-handling-lab</url>

    <scm>
        <connection>scm:git:https://github.com/Sebitas13/java-file-handling-lab.git</connection>
        <developerConnection>scm:git:git@github.com:Sebitas13/java-file-handling-lab.git</developerConnection>
        <url>https://github.com/Sebitas13/java-file-handling-lab</url>
    </scm>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>Sebitas13</id>
            <name>Sebastian Salazar</name>
            <url>https://github.com/Sebitas13</url>
        </developer>
    </developers>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>io.github.sebitas13.filehandling.App</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
